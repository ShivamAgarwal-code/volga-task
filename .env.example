# Copy to .env and adjust. Docker Compose reads these defaults.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/transcriptions

# --- Redis / Celery broker + result backend ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible; MinIO by default) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audio-uploads
S3_REGION=us-east-1

# --- Transcription ---
WHISPER_MODEL=base            # tiny | base | small | medium | large
# Files longer than this (seconds) are split into chunks before transcription.
CHUNK_THRESHOLD_SECONDS=600
CHUNK_LENGTH_SECONDS=300

# --- Upload limits ---
MAX_UPLOAD_MB=100
